  "voz": "hombre",
  "origen": "grabación"
 },
 "013": {
  "texto": "El monumento a Luis Fader está en la plaza central.",
  "archivo": "3e8b345ffc89.mp3",
  "voz": "hombre",
  "origen": "grabación"
 },
 "014": {
  "texto": "Este billete del Banco de Sinea es de doscientos rublos. (200)",
  "archivo": "276c9291ab00.mp3",
  "voz": "hombre",
  "origen": "grabación"
 },
 "015": {
  "texto": "A mí me gustan las estrellas.",
  "archivo": "54af1bddb331.mp3",
  "voz": "mujer",
  "origen": "grabación"
 },
 "016": {
  "texto": "A Marcos le gustan los mapas antiguos.",
  "archivo": "b6d292fc5024.mp3",
  "voz": "mujer",
  "origen": "grabación"
 },
 "017": {
  "texto": "Alicia tiene que comprar frutas.",
  "archivo": "efbbcae32d44.mp3",
  "voz": "hombre",
  "origen": "grabación"
 },
 "018": {
  "texto": "Nátasha está tocando el gusli.",
